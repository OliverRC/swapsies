{
  "name": "swapsies",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "db:local": "wrangler d1 execute swapsies --local --file=schema.sql",
    "db:remote": "wrangler d1 execute swapsies --remote --file=schema.sql",
    "deploy": "nuxt build && wrangler deploy",
    "test": "node --test server/utils/matching.test.ts",
    "reorder": "nuxt build && STICKERS=stickers.before.json ./backup.sh && wrangler d1 execute swapsies --remote -y --file=migrate.sql && wrangler deploy && wrangler d1 execute swapsies --local -y --file=migrate.sql; rm -f migrate.sql stickers.before.json",
    "backup": "./backup.sh"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "nuxt": "^3.21.11",
    "nuxt-auth-utils": "^0.5.30",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "nitro-cloudflare-dev": "^0.2.2",
    "wrangler": "^4.135.0"
  }
}
